     xmlns:foaf="http://xmlns.com/foaf/0.1/"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:vann="http://purl.org/vocab/vann/"
     xmlns:terms="http://purl.org/dc/terms/"
     xmlns:schema="https://schema.org/">
    <owl:Ontology rdf:about="https://edint.es/def/turismo#">
        <owl:versionIRI rdf:resource="https://edint.es/def/turismo/0.1.0"/>
        <terms:abstract xml:lang="en">Ontology for representing tourist accommodation and points of interest in a municipality, reusing classes and properties from the SEGITTUR ontology. It covers accommodation establishments (hotels, guesthouses, aparthotels, holiday rentals) with their category, units and location, as well as historical and cultural resources.</terms:abstract>
        <terms:abstract xml:lang="es">Ontología para la representación de alojamientos y puntos de interés turísticos de un municipio, que reutiliza clases y propiedades de la ontología SEGITTUR. Cubre establecimientos de alojamiento (hoteles, hostales, aparthoteles, alquileres vacacionales) con su categoría, unidades y localización, así como recursos históricos y culturales. Su propósito es proporcionar un vocabulario común para conocer y gestionar el turismo municipal, como base para su explotación a través de la Ontología de Cubos de Turismo.</terms:abstract>
        <terms:bibliographicCitation xml:lang="en">EDINT Tourism Ontology. EDINT. Revision: v0.1.0.</terms:bibliographicCitation>
        <terms:bibliographicCitation xml:lang="es">Ontología EDINT de Turismo. EDINT. Revisión: v0.1.0.</terms:bibliographicCitation>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-09-23</terms:created>
        <terms:creator rdf:nodeID="genid1"/>
        <terms:creator rdf:nodeID="genid2"/>
        <terms:creator rdf:nodeID="genid3"/>
        <terms:creator rdf:nodeID="genid4"/>
        <terms:creator rdf:nodeID="genid5"/>
        <terms:description xml:lang="en">Ontology for representing tourist accommodation and points of interest in a municipality, reusing classes and properties from the SEGITTUR ontology. It covers accommodation establishments (hotels, guesthouses, aparthotels, holiday rentals) with their category, units and location, as well as historical and cultural resources.</terms:description>
        <terms:description xml:lang="es">Ontología para la representación de alojamientos y puntos de interés turísticos de un municipio, que reutiliza clases y propiedades de la ontología SEGITTUR. Cubre establecimientos de alojamiento (hoteles, hostales, aparthoteles, alquileres vacacionales) con su categoría, unidades y localización, así como recursos históricos y culturales. Su propósito es proporcionar un vocabulario común para conocer y gestionar el turismo municipal, como base para su explotación a través de la Ontología de Cubos de Turismo.</terms:description>
        <terms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-09-23</terms:issued>
        <terms:license rdf:resource="https://creativecommons.org/licenses/by-sa/4.0/"/>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-09-23</terms:modified>
        <terms:publisher rdf:nodeID="genid6"/>
        <terms:title xml:lang="en">EDINT Tourism Ontology</terms:title>
        <terms:title xml:lang="es">Ontología EDINT de Turismo</terms:title>
        <vann:preferredNamespacePrefix>segittur</vann:preferredNamespacePrefix>
        <vann:preferredNamespaceUri rdf:resource="https://edint.es/def/turismo#"/>
        <rdfs:label xml:lang="en">Tourism</rdfs:label>
        <rdfs:label xml:lang="es">Turismo</rdfs:label>
        <owl:versionInfo>0.1.0</owl:versionInfo>
        <schema:codeRepository rdf:resource="https://github.com/EDINT-Ontologia/edint-ontologia-turismo"/>
        <schema:creativeWorkStatus xml:lang="en">Ontology Specification</schema:creativeWorkStatus>
        <schema:funding>Espacio de Datos para las Infraestructuras Urbanas Inteligentes (EDINT)</schema:funding>
    </owl:Ontology>
