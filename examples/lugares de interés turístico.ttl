  estur:telephone "921466720";
  estur:url "www.turismosegovia.com" .

ex:Desc_alcala-0 a estur:Description;
  estur:longDescription "Palacio fortificado compuesto por zonas construidas en diferentes etapas históricas. Hoy alberga el obispado y valiosos archivos.";
  estur:shortDescription "Residencia histórica fortificada." .

ex:Desc_alcala-1 a estur:Description;
  estur:longDescription "Antigua ciudad romana que alberga los restos de la infraestructura de espectáculos y vida pública de la antigua Complutum.";
  estur:shortDescription "Restos del anfiteatro romano." .

ex:Desc_seg-0 a estur:Description;
  estur:longDescription "El Acueducto de Segovia es una de las obras de ingeniería civil romana más impresionantes y mejor conservadas que conducía las aguas a la ciudad.";
  estur:shortDescription "Obra de ingeniería civil romana." .

ex:cultural/alcazar/alcala-0 a estur:Alcazar;
  estur:hasDescription ex:Desc_alcala-0;
  estur:hasLocation ex:location/Location_alcala-0;
  estur:name "Palacio Arzobispal" .

ex:cultural/alcazar/alcala-1 a estur:Amphiteatre;
  estur:hasDescription ex:Desc_alcala-1;
  estur:hasLocation ex:location/Location_alcala-1;
  estur:name "Complutum" .

ex:cultural/alcazar/seg-0 a estur:Acueduct;
  estur:hasDescription ex:Desc_seg-0;
  estur:hasLocation ex:location/Location_seg-0;
  estur:name "Acueducto de Segovia" .

