ex:Contact_alcala-0 a estur:ContactPoint;
  estur:email "turismo@ayto-alcaladehenares.es";
  estur:telephone "918892694";
  estur:url "www.turismoalcala.es" .

ex:Contact_alcala-1 a estur:ContactPoint;
  estur:email "complutum@ayto-alcaladehenares.es";
  estur:telephone "918892694";
  estur:url "www.turismoalcala.es" .

ex:Contact_seg-0 a estur:ContactPoint;
